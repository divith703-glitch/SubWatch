{
  "name": "subwatch",
  "version": "1.0.0",
  "private": true,
  "description": "A subscription management platform that helps users track recurring expenses, monitor price changes, and avoid unwanted renewals.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "npm --prefix client run dev",
    "build": "npm run build:server && npm --prefix client install && npm --prefix client run build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && npm --prefix client run typecheck",
    "test": "tsx --test server/util.test.ts server/security.test.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start:prod": "node dist-server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
